{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Patch",
            "type": "shell",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File lib/scripts/patch_local.ps1 -DeviceId \"${command:flutter.getSelectedDeviceId}\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Restore SDK",
            "type": "shell",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File lib/scripts/patch_local.ps1 -Restore",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Package Python",
            "type": "shell",
            "command": "python tool/package_python.py --device-id \"${command:flutter.getSelectedDeviceId}\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Generate jni",
            "type": "shell",
            "command": "dart run tool/jnigen.dart",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
